{
  "name": "@lattice/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "ng serve --host 127.0.0.1 --port 1420",
    "build": "ng build",
    "build:web": "ng build",
    "tauri:build": "tauri build --no-bundle",
    "lint": "pnpm --workspace-root exec eslint apps/desktop",
    "typecheck": "ng build --configuration development --no-progress",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.1.5",
    "@angular/compiler": "22.1.5",
    "@angular/core": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "@angular/router": "22.1.5",
    "@lattice/types": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.5",
    "@angular/cli": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/angular": "19.4.2",
    "@testing-library/dom": "10.4.1",
    "@types/node": "22.20.1",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
