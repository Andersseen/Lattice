{
  "name": "lattice",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight, local-first workspace for models, agents, tools, and skills.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "scripts": {
    "dev": "turbo run dev --filter=@lattice/desktop",
    "build": "turbo run build && pnpm --filter @lattice/desktop tauri:build",
    "build:web": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && cargo test --workspace",
    "e2e": "pnpm --filter @lattice/desktop e2e",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && cargo check --workspace && cargo clippy --workspace --all-targets -- -D warnings",
    "openspec:validate": "pnpm dlx @fission-ai/openspec@latest validate --specs"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.2.0",
    "@angular-eslint/template-parser": "22.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  }
}
